<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Enrol_Applicant</name>
        <label>Enrol Applicant</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <actionName>RTS_EnrollmentService</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>leadIds</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <apiVersion>62.0</apiVersion>
    <description>When an RTS applicant confirms their offer (Lead Status = RTS - Accepted - Confirmed), convert the Lead to a Person Account and create their Program Engagement in the cohort's PMM cohort. RTS Flow 9 and RTS_ServiceParticipantTrigger then enrol them in the phases and put them on the class schedules. Runs as a Queueable (RTS_EnrollmentService), so the conversion happens a few seconds after the status change.</description>
    <environments>Default</environments>
    <interviewLabel>RTS Flow 10 - Enrol Accepted Applicant {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RTS Flow 10 - Enrol Accepted Applicant</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Enrol_Applicant</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>RTS - Accepted - Confirmed</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsConverted</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>RTS_Cohort__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Lead</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
