<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Set_Fiscal_Cycle</name>
        <label>Set Fiscal Cycle</label>
        <locationX>50</locationX>
        <locationY>458</locationY>
        <assignmentItems>
            <assignToReference>varEarlierCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>Get_Earlier_Cohorts</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Fiscal_Cycle__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fCycle</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Name_Ready</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Name</name>
        <label>Set Name</label>
        <locationX>50</locationX>
        <locationY>758</locationY>
        <assignmentItems>
            <assignToReference>$Record.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fName</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Cycle_Blank</name>
        <label>Fiscal Cycle blank?</label>
        <locationX>182</locationX>
        <locationY>158</locationY>
        <defaultConnector>
            <targetReference>Name_Ready</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Cycle_Is_Blank</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Fiscal_Cycle__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.pmdm__StartDate__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Earlier_Cohorts</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Name_Ready</name>
        <label>All name parts filled?</label>
        <locationX>182</locationX>
        <locationY>650</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Parts_Filled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Short_Code__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Cohort_Number__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.pmdm__StartDate__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Fiscal_Cycle__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Name</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Before-save flow. Names a Program Cohort &quot;{Short Code} Cohort {n} · {Season} {Year} · FY{yy}-CY{c}&quot;, e.g. RTS Cohort 2 · Fall 2026 · FY27-CY1. Season and year come from the start date (Dec-Feb Winter, Mar-May Spring, Jun-Aug Summer, Sep-Nov Fall); the fiscal year runs July-June. A blank Fiscal Cycle is filled with 1 + the number of the program's cohorts that start earlier in the same fiscal year; a typed value is kept. The name is only set when Short Code, Cohort Number, Start Date and Fiscal Cycle are all filled. Sends no email.</description>
    <environments>Default</environments>
    <formulas>
        <name>fCycle</name>
        <dataType>Number</dataType>
        <expression>{!varEarlierCount} + 1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fFiscalYear</name>
        <dataType>String</dataType>
        <expression>&quot;FY&quot; &amp; RIGHT(TEXT(YEAR({!$Record.pmdm__StartDate__c}) + IF(MONTH({!$Record.pmdm__StartDate__c}) &gt;= 7, 1, 0)), 2)</expression>
    </formulas>
    <formulas>
        <name>fFiscalYearStart</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR({!$Record.pmdm__StartDate__c}) - IF(MONTH({!$Record.pmdm__StartDate__c}) &gt;= 7, 0, 1), 7, 1)</expression>
    </formulas>
    <formulas>
        <name>fName</name>
        <dataType>String</dataType>
        <expression>UPPER(TRIM({!$Record.Short_Code__c})) &amp; &quot; Cohort &quot; &amp; TEXT({!$Record.Cohort_Number__c})
&amp; &quot; · &quot; &amp; {!fSeason} &amp; &quot; &quot; &amp; TEXT(YEAR({!$Record.pmdm__StartDate__c}))
&amp; &quot; · &quot; &amp; {!fFiscalYear} &amp; &quot;-CY&quot; &amp; TEXT({!$Record.Fiscal_Cycle__c})</expression>
    </formulas>
    <formulas>
        <name>fSeason</name>
        <dataType>String</dataType>
        <expression>CASE(MONTH({!$Record.pmdm__StartDate__c}),
  12, &quot;Winter&quot;, 1, &quot;Winter&quot;, 2, &quot;Winter&quot;,
  3, &quot;Spring&quot;, 4, &quot;Spring&quot;, 5, &quot;Spring&quot;,
  6, &quot;Summer&quot;, 7, &quot;Summer&quot;, 8, &quot;Summer&quot;,
  &quot;Fall&quot;)</expression>
    </formulas>
    <interviewLabel>Program Cohort Naming {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Program Cohort Naming</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Earlier_Cohorts</name>
        <label>Get earlier cohorts in the fiscal year</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_Fiscal_Cycle</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>pmdm__Program__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.pmdm__Program__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>pmdm__StartDate__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>fFiscalYearStart</elementReference>
            </value>
        </filters>
        <filters>
            <field>pmdm__StartDate__c</field>
            <operator>LessThan</operator>
            <value>
                <elementReference>$Record.pmdm__StartDate__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>pmdm__ProgramCohort__c</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Cycle_Blank</targetReference>
        </connector>
        <object>pmdm__ProgramCohort__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varEarlierCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
</Flow>
