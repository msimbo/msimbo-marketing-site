    <description>Record-triggered after-save flow with a scheduled path 1 hour before RTS_CM_Interview_DateTime__c (set by the n8n Lunacal Case Manager workflow). Emails the applicant a reminder. Re-checks at send time that the lead is still at RTS - Interview 2 Scheduled, the interview is still upcoming (within 2 hours), and the lead has an email and has not opted out. Logs a completed Task.</description>
    <environments>Default</environments>
    <formulas>
        <description>Sends only if the start time is still in the future and at most 2 hours away (guards against a stale path after a reschedule) and the lead still qualifies.</description>
        <name>ShouldSend</name>
        <dataType>Boolean</dataType>
        <expression>AND(NOT(ISBLANK({!$Record.RTS_CM_Interview_DateTime__c})), {!$Record.RTS_CM_Interview_DateTime__c} &gt; {!$Flow.CurrentDateTime}, {!$Record.RTS_CM_Interview_DateTime__c} - {!$Flow.CurrentDateTime} &lt;= 2/24, NOT(ISBLANK({!$Record.Email})), NOT({!$Record.HasOptedOutOfEmail}), AND({!$Record.RecordType.DeveloperName} = &apos;RTS_Applicant&apos;, ISPICKVAL({!$Record.Status}, &apos;RTS - Interview 2 Scheduled&apos;)))</expression>
    </formulas>
    <formulas>
        <description>Start time shifted to US Eastern wall-clock time (still typed as DateTime, so read it with TEXT(), never format it as a DateTime).</description>
        <name>StartLocal</name>
        <dataType>DateTime</dataType>
        <expression>{!$Record.RTS_CM_Interview_DateTime__c} - IF(AND({!$Record.RTS_CM_Interview_DateTime__c} &gt;= DATETIMEVALUE(TEXT(DATE(YEAR(DATEVALUE(LEFT(TEXT({!$Record.RTS_CM_Interview_DateTime__c}), 10))), 3, 1) + MOD(8 - WEEKDAY(DATE(YEAR(DATEVALUE(LEFT(TEXT({!$Record.RTS_CM_Interview_DateTime__c}), 10))), 3, 1)), 7) + 7) &amp; &apos; 07:00:00&apos;), {!$Record.RTS_CM_Interview_DateTime__c} &lt; DATETIMEVALUE(TEXT(DATE(YEAR(DATEVALUE(LEFT(TEXT({!$Record.RTS_CM_Interview_DateTime__c}), 10))), 11, 1) + MOD(8 - WEEKDAY(DATE(YEAR(DATEVALUE(LEFT(TEXT({!$Record.RTS_CM_Interview_DateTime__c}), 10))), 11, 1)), 7)) &amp; &apos; 06:00:00&apos;)), 4, 5) / 24</expression>
    </formulas>
    <formulas>
        <name>StartDayText</name>
        <dataType>String</dataType>
        <expression>CASE(WEEKDAY(DATEVALUE(LEFT(TEXT({!StartLocal}), 10))), 1, &apos;Sunday&apos;, 2, &apos;Monday&apos;, 3, &apos;Tuesday&apos;, 4, &apos;Wednesday&apos;, 5, &apos;Thursday&apos;, 6, &apos;Friday&apos;, 7, &apos;Saturday&apos;, &apos;&apos;) &amp; &apos;, &apos; &amp; CASE(MONTH(DATEVALUE(LEFT(TEXT({!StartLocal}), 10))), 1, &apos;January&apos;, 2, &apos;February&apos;, 3, &apos;March&apos;, 4, &apos;April&apos;, 5, &apos;May&apos;, 6, &apos;June&apos;, 7, &apos;July&apos;, 8, &apos;August&apos;, 9, &apos;September&apos;, 10, &apos;October&apos;, 11, &apos;November&apos;, 12, &apos;December&apos;, &apos;&apos;) &amp; &apos; &apos; &amp; TEXT(DAY(DATEVALUE(LEFT(TEXT({!StartLocal}), 10))))</expression>
    </formulas>
    <formulas>
        <name>StartTimeText</name>
        <dataType>String</dataType>
        <expression>TEXT(IF(MOD(VALUE(MID(TEXT({!StartLocal}), 12, 2)), 12) = 0, 12, MOD(VALUE(MID(TEXT({!StartLocal}), 12, 2)), 12))) &amp; &apos;:&apos; &amp; MID(TEXT({!StartLocal}), 15, 2) &amp; IF(VALUE(MID(TEXT({!StartLocal}), 12, 2)) &lt; 12, &apos; AM&apos;, &apos; PM&apos;) &amp; &apos; ET&apos;</expression>
    </formulas>
