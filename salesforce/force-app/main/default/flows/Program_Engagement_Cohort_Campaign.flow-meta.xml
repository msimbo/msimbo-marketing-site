<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Use_Existing_Campaign</name>
        <label>Use existing campaign</label>
        <locationX>50</locationX>
        <locationY>1100</locationY>
        <assignmentItems>
            <assignToReference>varCampaignId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Cohort.Student_Campaign__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Member</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Left_Old_Cohort</name>
        <label>Moved off another cohort?</label>
        <locationX>380</locationX>
        <locationY>200</locationY>
        <defaultConnector>
            <targetReference>Has_Cohort</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Old_Cohort_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.pmdm__ProgramCohort__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.pmdm__ProgramCohort__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.pmdm__ProgramCohort__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Old_Cohort</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Old_Has_Campaign</name>
        <label>Old cohort has a campaign?</label>
        <locationX>50</locationX>
        <locationY>400</locationY>
        <defaultConnector>
            <targetReference>Has_Cohort</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Old_Campaign_Set</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Old_Cohort.Student_Campaign__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Remove_From_Old_Campaign</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Cohort</name>
        <label>Has a cohort?</label>
        <locationX>380</locationX>
        <locationY>600</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Cohort_Set</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.pmdm__ProgramCohort__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Cohort</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Student</name>
        <label>Enrolled, Active or Completed?</label>
        <locationX>380</locationX>
        <locationY>850</locationY>
        <defaultConnector>
            <targetReference>Cohort_Has_Campaign</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Student_Stage</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.pmdm__Stage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Enrolled</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.pmdm__Stage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Active</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.pmdm__Stage__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Campaign_Exists</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Campaign_Exists</name>
        <label>Cohort has a campaign?</label>
        <locationX>182</locationX>
        <locationY>970</locationY>
        <defaultConnector>
            <targetReference>Create_Campaign</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Campaign_Set</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Cohort.Student_Campaign__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Use_Existing_Campaign</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Not_Member</name>
        <label>Not a member yet?</label>
        <locationX>182</locationX>
        <locationY>1400</locationY>
        <defaultConnectorLabel>Already a member</defaultConnectorLabel>
        <rules>
            <name>No_Member</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Member</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Member</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Cohort_Has_Campaign</name>
        <label>Cohort has a campaign? (remove)</label>
        <locationX>578</locationX>
        <locationY>970</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Remove_Campaign_Set</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Cohort.Student_Campaign__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Remove_Member</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>After-save flow on pmdm__ProgramEngagement__c (Client role). Keeps each cohort's Student Campaign (pmdm__ProgramCohort__c.Student_Campaign__c) in step with who is in the cohort, so staff can Send List Email from the campaign. Enrolled, Active or Completed: adds the Contact as a Campaign Member, creating the campaign ("{cohort name} · Students") the first time. Any other stage (e.g. Withdrawn): removes them. Moving an engagement to another cohort removes them from the old cohort's campaign. Works for every program, not only RTS.</description>
    <environments>Default</environments>
    <formulas>
        <name>fCampaignName</name>
        <dataType>String</dataType>
        <expression>LEFT({!Get_Cohort.Name}, 69) &amp; &quot; · Students&quot;</expression>
    </formulas>
    <interviewLabel>Program Engagement Cohort Campaign {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Program Engagement Cohort Campaign</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Campaign</name>
        <label>Create the cohort's student campaign</label>
        <locationX>314</locationX>
        <locationY>1100</locationY>
        <assignRecordIdToReference>varCampaignId</assignRecordIdToReference>
        <connector>
            <targetReference>Link_Campaign</targetReference>
        </connector>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>fCampaignName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Type</field>
            <value>
                <stringValue>Email</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>In Progress</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>IsActive</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>Students in this cohort, kept up to date automatically by the Program Engagement Cohort Campaign flow. To email them: select the members below and click Send List Email. Don&apos;t add or remove members by hand; change the Program Engagement stage instead.</stringValue>
            </value>
        </inputAssignments>
        <object>Campaign</object>
    </recordCreates>
    <recordCreates>
        <name>Add_Member</name>
        <label>Add to campaign</label>
        <locationX>50</locationX>
        <locationY>1520</locationY>
        <inputAssignments>
            <field>CampaignId</field>
            <value>
                <elementReference>varCampaignId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ContactId</field>
            <value>
                <elementReference>$Record.pmdm__Contact__c</elementReference>
            </value>
        </inputAssignments>
        <object>CampaignMember</object>
    </recordCreates>
    <recordDeletes>
        <name>Remove_From_Old_Campaign</name>
        <label>Remove from old cohort's campaign</label>
        <locationX>50</locationX>
        <locationY>500</locationY>
        <connector>
            <targetReference>Has_Cohort</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CampaignId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Old_Cohort.Student_Campaign__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.pmdm__Contact__c</elementReference>
            </value>
        </filters>
        <object>CampaignMember</object>
    </recordDeletes>
    <recordDeletes>
        <name>Remove_Member</name>
        <label>Remove from campaign</label>
        <locationX>446</locationX>
        <locationY>1100</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CampaignId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Cohort.Student_Campaign__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.pmdm__Contact__c</elementReference>
            </value>
        </filters>
        <object>CampaignMember</object>
    </recordDeletes>
    <recordLookups>
        <name>Get_Old_Cohort</name>
        <label>Get the old cohort</label>
        <locationX>50</locationX>
        <locationY>300</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Old_Has_Campaign</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record__Prior.pmdm__ProgramCohort__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>pmdm__ProgramCohort__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Student_Campaign__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Cohort</name>
        <label>Get the cohort</label>
        <locationX>380</locationX>
        <locationY>720</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Student</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.pmdm__ProgramCohort__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>pmdm__ProgramCohort__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Student_Campaign__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Member</name>
        <label>Already a member?</label>
        <locationX>182</locationX>
        <locationY>1280</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Not_Member</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CampaignId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varCampaignId</elementReference>
            </value>
        </filters>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.pmdm__Contact__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CampaignMember</object>
        <queriedFields>Id</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Link_Campaign</name>
        <label>Save the campaign on the cohort</label>
        <locationX>314</locationX>
        <locationY>1200</locationY>
        <connector>
            <targetReference>Get_Member</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Cohort.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Student_Campaign__c</field>
            <value>
                <elementReference>varCampaignId</elementReference>
            </value>
        </inputAssignments>
        <object>pmdm__ProgramCohort__c</object>
    </recordUpdates>
    <start>
        <locationX>254</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Left_Old_Cohort</targetReference>
        </connector>
        <filterFormula>NOT(ISBLANK({!$Record.pmdm__Contact__c})) &amp;&amp; TEXT({!$Record.pmdm__Role__c}) = &quot;Client&quot; &amp;&amp; (ISNEW() || ISCHANGED({!$Record.pmdm__Stage__c}) || ISCHANGED({!$Record.pmdm__ProgramCohort__c}))</filterFormula>
        <object>pmdm__ProgramEngagement__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varCampaignId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
