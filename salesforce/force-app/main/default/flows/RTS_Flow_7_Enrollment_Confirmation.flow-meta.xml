    <apiVersion>62.0</apiVersion>
    <description>Fires when Coordinator moves a Lead to Status = RTS - Accepted - Confirmed. Sends the Enrollment Confirmation email, stamps Offer_Response = Confirmed with today&apos;s date, and creates a same-day task for the Program Coordinator to check the enrolment that RTS Flow 10 sets up.</description>
    <environments>Default</environments>
    <formulas>
        <name>TaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Check enrolment — &quot; &amp; {!$Record.FirstName} &amp; &quot; &quot; &amp; {!$Record.LastName}</expression>
    </formulas>
    <interviewLabel>RTS Flow 7 — Enrollment Confirmation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RTS Flow 7 — Enrollment Confirmation</label>
    <processMetadataValues>
