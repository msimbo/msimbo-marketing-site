<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>After-save flow on pmdm__ProgramEngagement__c. When a new engagement is created for an RTS-program trainee, looks up all active Services tied to the same Program and creates one pmdm__ServiceParticipant__c per Service. Also defaults RTS_Completion_Status__c to Enrolled if not already set. Paired with Flow 4 (Lead conversion) which creates the engagement.</description>
    <environments>Default</environments>
    <interviewLabel>RTS Flow 9 — Auto-create ServiceParticipants {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RTS Flow 9 — Auto-create ServiceParticipants</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Active_Services</name>
        <label>Get Active Services for Program</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Services</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>pmdm__Program__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.pmdm__Program__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>pmdm__Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>pmdm__Service__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <decisions>
        <name>Has_Services</name>
        <label>Has Services?</label>
        <locationX>176</locationX>
        <locationY>288</locationY>
        <defaultConnectorLabel>None Found</defaultConnectorLabel>
        <rules>
            <name>Found_Services</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Active_Services</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Services</targetReference>
            </connector>
            <label>Found Services</label>
        </rules>
    </decisions>
    <loops>
        <name>Loop_Services</name>
        <label>Loop Services</label>
        <locationX>176</locationX>
        <locationY>408</locationY>
        <collectionReference>Get_Active_Services</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Build_Participant</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_Participants</targetReference>
        </noMoreValuesConnector>
    </loops>
    <assignments>
        <name>Build_Participant</name>
        <label>Build Participant Record</label>
        <locationX>50</locationX>
        <locationY>528</locationY>
        <assignmentItems>
            <assignToReference>NewParticipant.pmdm__Contact__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.pmdm__Contact__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewParticipant.pmdm__ProgramEngagement__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewParticipant.pmdm__Service__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Services.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewParticipant.pmdm__Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ParticipantsToCreate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>NewParticipant</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Services</targetReference>
        </connector>
    </assignments>
    <recordCreates>
        <name>Create_Participants</name>
        <label>Create Service Participants</label>
        <locationX>176</locationX>
        <locationY>648</locationY>
        <inputReference>ParticipantsToCreate</inputReference>
    </recordCreates>
    <variables>
        <name>NewParticipant</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>pmdm__ServiceParticipant__c</objectType>
    </variables>
    <variables>
        <name>ParticipantsToCreate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>pmdm__ServiceParticipant__c</objectType>
    </variables>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Active_Services</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>pmdm__Program__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>pmdm__Contact__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>pmdm__ProgramEngagement__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
