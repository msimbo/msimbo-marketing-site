<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Set_Interview_Requested</name>
        <label>Set Status to Interview Requested</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <assignmentItems>
            <assignToReference>$Record.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>RTS - Interview 1 Requested</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <description>Before-save flow. When an RTS Applicant Lead reaches Status = RTS - Assessment Complete with Assessment Status = Passed and all three scores (CLIK, CCAT, CBST2) filled in, moves Status to RTS - Interview 1 Requested in the same save. Flow 2 (after-save) then sends the Instructor Interview Invitation. Retake Required and Did Not Pass stay at Assessment Complete for the coordinator. Also advances returning applicants the website places at Assessment Complete.</description>
    <environments>Default</environments>
    <interviewLabel>RTS Flow 2a — Auto-Advance to Interview {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RTS Flow 2a — Auto-Advance to Interview</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Interview_Requested</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>AND(
  {!$Record.RecordType.DeveloperName} = &apos;RTS_Applicant&apos;,
  ISPICKVAL({!$Record.Status}, &apos;RTS - Assessment Complete&apos;),
  ISPICKVAL({!$Record.RTS_Assessment_Status__c}, &apos;Passed&apos;),
  NOT(ISBLANK({!$Record.RTS_CLIK_Score__c})),
  NOT(ISBLANK({!$Record.RTS_CCAT_Score__c})),
  NOT(ISBLANK({!$Record.RTS_CBST2_Score__c}))
)</filterFormula>
        <object>Lead</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
