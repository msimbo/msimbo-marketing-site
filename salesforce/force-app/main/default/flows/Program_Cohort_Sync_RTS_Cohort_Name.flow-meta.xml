<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <description>After-save flow. When a Program Cohort's name changes, copies it to the RTS Cohort records that point at it (RTS_Cohort__c.PMM_Cohort__c), so both objects carry the same name. Note: the per-cohort Lead list views filter on the RTS Cohort name and must be redeployed after a rename. Sends no email.</description>
    <environments>Default</environments>
    <interviewLabel>Program Cohort — Sync RTS Cohort Name {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Program Cohort — Sync RTS Cohort Name</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_RTS_Cohorts</name>
        <label>Update linked RTS Cohorts</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>PMM_Cohort__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>$Record.Name</elementReference>
            </value>
        </inputAssignments>
        <object>RTS_Cohort__c</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_RTS_Cohorts</targetReference>
        </connector>
        <filterFormula>ISCHANGED({!$Record.Name})</filterFormula>
        <object>pmdm__ProgramCohort__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
